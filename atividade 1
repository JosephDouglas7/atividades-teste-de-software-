import unittest

class Operacoes:
    def __init__(self, a, b):
        self.a = a
        self.b = b

    def soma(self):
        return self.a + self.b

    def subtracao(self):
        return self.a - self.b

    def multiplicacao(self):
        return self.a * self.b

    def divisao(self):
        if self.b == 0:
            return "Erro: divisão por zero"
        return self.a / self.b

class TestOperacoes(unittest.TestCase):
    def setUp(self):
        self.op = Operacoes(10, 5)

    def test_soma(self):
        self.assertEqual(self.op.soma(), 15)

    def test_subtracao(self):
        self.assertEqual(self.op.subtracao(), 5)

    def test_multiplicacao(self):
        self.assertEqual(self.op.multiplicacao(), 50)

    def test_divisao(self):
        self.assertEqual(self.op.divisao(), 2)

    def test_divisao_por_zero(self):
        op_zero = Operacoes(10, 0)
        self.assertEqual(op_zero.divisao(), "Erro: divisão por zero")

if __name__ == "__main__":
    unittest.main()
